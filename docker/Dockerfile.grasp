# ============================================================================
# Perception Grasp Dockerfile (CUDA 12.8 + ROS Noetic + Python 3.10)
# Keep Ubuntu 20.04 for ROS Noetic, but ship a self-contained Python runtime
# for modern PyTorch/cu128 instead of relying on focal apt python3.10 packages.
# ============================================================================
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu20.04 as grasp_base

# 设置时区和语言
ENV TZ=Asia/Shanghai
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive
ENV CONDA_DIR=/opt/conda
ENV GRASP_PYTHON_ENV=/opt/conda/envs/grasp-py310
ENV PATH=${GRASP_PYTHON_ENV}/bin:${CONDA_DIR}/bin:${PATH}
ENV PIP_NO_CACHE_DIR=1
ENV CUDA_HOME=/usr/local/cuda

# 安装 ROS Noetic 与构建依赖
RUN apt-get update && apt-get install -y     lsb-release     gnupg2     curl     ca-certificates     bzip2     python3-pip     build-essential     git     libgl1     libglib2.0-0     && sh -c 'echo "deb http://packages.ros.org/ros/ubuntu $(lsb_release -sc) main" > /etc/apt/sources.list.d/ros-latest.list'     && curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | apt-key add -     && apt-get update && apt-get install -y     python3-catkin-tools     ros-noetic-ros-base     ros-noetic-cv-bridge     ros-noetic-geometry-msgs     ros-noetic-tf2-ros     ros-noetic-moveit-msgs     ros-noetic-trajectory-msgs     && rm -rf /var/lib/apt/lists/*

# 自带 Python 3.10（避免 focal 上 python3.10-dev/venv 包缺失）
RUN curl -L -o /tmp/miniforge.sh       https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh &&     bash /tmp/miniforge.sh -b -p ${CONDA_DIR} &&     rm -f /tmp/miniforge.sh &&     ${CONDA_DIR}/bin/conda create -y -n grasp-py310 python=3.10 &&     ${CONDA_DIR}/bin/conda clean -afy &&     ${GRASP_PYTHON_ENV}/bin/python -m pip install --upgrade pip setuptools wheel

# 安装 Python 依赖（CUDA 12.8 / Python 3.10）
COPY src/perception_grasp/requirements.txt /tmp/requirements.txt
RUN ${GRASP_PYTHON_ENV}/bin/python -m pip install \
      torch==2.7.0 torchvision==0.22.0 \
      --index-url https://download.pytorch.org/whl/cu128 && \
    ${GRASP_PYTHON_ENV}/bin/python -m pip install --ignore-installed PyYAML -r /tmp/requirements.txt

# ============================================================================
# Stage 1: Build
# ============================================================================
FROM grasp_base as grasp_builder

WORKDIR /workspace
RUN mkdir -p /workspace/src

# 复制源码
COPY src/common_msgs /workspace/src/common_msgs
COPY src/perception_grasp /workspace/src/perception_grasp

# 编译
RUN /bin/bash -lc "source /opt/ros/noetic/setup.bash &&     cd /workspace &&     catkin config --extend /opt/ros/noetic       --cmake-args -DPYTHON_EXECUTABLE=${GRASP_PYTHON_ENV}/bin/python -DPYTHON_VERSION=3.10 &&     catkin build common_msgs perception_grasp"

# ============================================================================
# Stage 2: Runtime
# ============================================================================
FROM grasp_base as grasp_runtime

# 复制编译结果
COPY --from=grasp_builder /workspace/devel /workspace/devel
COPY --from=grasp_builder /workspace/src /workspace/src

# 创建默认权重目录（运行时通常会挂载宿主机 ./weights 到 /workspace/weights）
RUN mkdir -p /workspace/weights/graspnet /tmp/torch_extensions

ENV TORCH_EXTENSIONS_DIR=/tmp/torch_extensions

WORKDIR /workspace

# 设置入口点
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["roslaunch", "perception_grasp", "grasp_estimator.launch"]
